# 动态设置对话框模板
data modify storage sc:dlg rules set value {"type":"minecraft:confirmation","title":{"text":"⚙ 调整比赛规则","color":"gold","bold":true},"pause":false,"body":{"type":"minecraft:plain_message","contents":{"text":"设置在下一场生效。反色看玩家与球沿准星方向互相靠近的速度，不是只看玩家跑多快。参考：无速度效果、平地不跳跃时，普通疾跑约 5.61 格/秒。","color":"gray"},"width":330},"inputs":[],"yes":{"label":{"text":"保存设置","color":"green"},"action":{"type":"dynamic/run_command","template":"trigger sc_set set 1$(du)$(ba)$(bl)$(la)$(sp)$(gr)$(pa)"}},"no":{"label":"取消"}}
