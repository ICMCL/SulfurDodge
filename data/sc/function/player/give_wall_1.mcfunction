# 给玩家发放 1 个可放置反弹墙（优先放入空的 3 号位快捷栏，否则叠加进背包）
execute unless items entity @s container.* minecraft:mud_bricks unless items entity @s hotbar.2 * run return run item replace entity @s hotbar.2 with minecraft:mud_bricks[custom_data={sc_kit:1b,sc_wall_item:1b},item_name={text:"可放置反弹墙",color:"gold",bold:true,italic:false},lore=[{text:"对准地面右键放置 2 格高反弹墙",color:"yellow",italic:false},{text:"可折射硫方怪弹道，会被撞坏或炸毁！",color:"gray",italic:false}],can_place_on={blocks:"#sc:paintable_floor"},tooltip_display={hidden_components:["minecraft:can_place_on"]}] 1
give @s minecraft:mud_bricks[custom_data={sc_kit:1b,sc_wall_item:1b},item_name={text:"可放置反弹墙",color:"gold",bold:true,italic:false},lore=[{text:"对准地面右键放置 2 格高反弹墙",color:"yellow",italic:false},{text:"可折射硫方怪弹道，会被撞坏或炸毁！",color:"gray",italic:false}],can_place_on={blocks:"#sc:paintable_floor"},tooltip_display={hidden_components:["minecraft:can_place_on"]}] 1
