# 确保 1 号位击球长矛与 2 号位突进短矛始终在背包中
# 客户端按三个条件的时长绘制架矛姿势，不能省略。保留钻石矛的动画参数；不可达的速度门槛只禁用原生撞击，反色仍由数据包判定。
execute unless items entity @s container.* minecraft:diamond_spear run item replace entity @s hotbar.0 with minecraft:diamond_spear[custom_data={sc_kit:1b,sc_spear:1b},item_name={text:"击球长矛",color:"aqua",bold:true,italic:false},lore=[{text:"左键：未点燃球染色 / 己方燃球续时 / 其余燃球拨开",color:"gray",italic:false},{text:"右键：迎击倒计时的白球或敌球，速度达标即可夺色",color:"yellow",italic:false},{text:"最后 0.5 秒锁色；夺色不续时",color:"dark_aqua",italic:false}],unbreakable={},kinetic_weapon={delay_ticks:10,forward_movement:0.38f,dismount_conditions:{max_duration_ticks:60,min_speed:1.0e30f},knockback_conditions:{max_duration_ticks:130,min_speed:1.0e30f},damage_conditions:{max_duration_ticks:200,min_speed:1.0e30f}},attack_range={min_reach:0.0f,max_reach:4.5f,min_creative_reach:0.0f,max_creative_reach:5.0f,hitbox_margin:0.35f},enchantments={"sc:jab_hook":1},enchantment_glint_override=false,tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable"]}]

execute unless items entity @s container.* minecraft:golden_spear run item replace entity @s hotbar.1 with minecraft:golden_spear[custom_data={sc_kit:1b},item_name={text:"突进短矛 [突进 II]",color:"gold",bold:true,italic:false},lore=[{text:"左键：突进，平射己方燃球，碰墙或敌人即爆",color:"gold",italic:false},{text:"按住右键：矛尖前 2 格引力点牵引周围 4 格的球",color:"light_purple",italic:false},{text:"引力不耗体力；不改色、不点火、不解触爆",color:"gray",italic:false}],unbreakable={},kinetic_weapon={delay_ticks:5,forward_movement:0.38f,damage_conditions:{max_duration_ticks:200,min_speed:1.0e30f},knockback_conditions:{max_duration_ticks:130,min_speed:1.0e30f},dismount_conditions:{max_duration_ticks:60,min_speed:1.0e30f}},attack_range={min_reach:0.0f,max_reach:0.0f,min_creative_reach:0.0f,max_creative_reach:0.0f,hitbox_margin:0.0f},enchantments={"minecraft:lunge":2,"sc:dash_hook":1},tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable"]}]
